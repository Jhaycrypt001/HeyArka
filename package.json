{
  "name": "heyarka",
  "private": true,
  "version": "0.1.0",
  "description": "Adversarial evaluation harness and hardening layer for LLM trading agents",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build",
    "test": "pnpm -r --filter \"./packages/**\" test",
    "typecheck": "pnpm -r --filter \"./packages/**\" exec tsc --noEmit",
    "attack": "node packages/cli/dist/bin.js attack --demo"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@heyarka/cli": "workspace:*"
  },
  "packageManager": "pnpm@10.33.2"
}
